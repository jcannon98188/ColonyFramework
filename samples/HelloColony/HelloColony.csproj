<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The minimal headless host of spec sections 11.1 and 14, built from the hello-colony sketch (Sketch.cs is
    the sketch as it compiles today; the doc test in HelloColony.Tests diffs it against the spec). Runs on JIT
    and Native AOT (IlcInstructionSet x86-64-v3, like tests/Colony.Testing.AotHost) and attaches the
    Colony.Diagnostics sinks behind flags, so later tickets have a host to point dotnet-counters and Perfetto at.
    Run:      dotnet run -c Release (project samples/HelloColony) [ticks 1000] [colonists 100] [workers 1] [save colony.save | no-save] [counters] [trace out.json] [level Detailed] [pace ms] [sketch]; see HelloColonyHost.cs for the option names.
    Publish:  dotnet publish samples/HelloColony -c Release -r win-x64   (or linux-x64) into artifacts/publish/HelloColony/
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <PublishAot>true</PublishAot>
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <RootNamespace>Colony.Samples.Hello</RootNamespace>
    <AssemblyName>HelloColony</AssemblyName>
    <!-- CA1051/CA1815: the sketch's Components are plain public-field structs, as the spec writes them. -->
    <NoWarn>$(NoWarn);CA1051;CA1815</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Colony.Core\Colony.Core.csproj" />
    <ProjectReference Include="..\..\src\Colony.Fields\Colony.Fields.csproj" />
    <ProjectReference Include="..\..\src\Colony.Persistence\Colony.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Colony.Diagnostics\Colony.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\Colony.Generators\Colony.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

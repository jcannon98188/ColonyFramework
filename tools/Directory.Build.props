<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Development-only tooling (spec section 14): never referenced by src/, never shipped. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Colony.Tools</RootNamespace>
  </PropertyGroup>

</Project>

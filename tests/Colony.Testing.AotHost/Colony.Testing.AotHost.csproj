<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT host for the determinism harness (spec section 6, Tier 1; section 10.3): runs a named scenario
    through Colony.Testing's HarnessHost and prints its World hashes, so the AOT comparison tests can check a
    Native AOT build (IlcInstructionSet x86-64-v3) against the JIT run. Replaces TASK-7's Colony.Core.AotHost.
    Publish:  dotnet publish tests/Colony.Testing.AotHost -c Release -r win-x64   (or linux-x64)
    Output:   artifacts/publish/Colony.Testing.AotHost/release_<rid>/Colony.Testing.AotHost(.exe)
    Run:      Colony.Testing.AotHost [scenario colonist] [ticks 30] [workers 1,4] [every 1]; see HarnessHost for the option names.
    Not a test project: it links the scenario sources from Colony.Testing.Tests instead of referencing it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Colony.Testing.AotHost</RootNamespace>
    <!-- CA1515 wants internal types; the scenario types are public so the test project can share the files. -->
    <NoWarn>$(NoWarn);CA1515;CA1051;CA1815</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Colony.Testing\Colony.Testing.csproj" />
    <ProjectReference Include="..\..\src\Colony.Colony\Colony.Colony.csproj" />
    <ProjectReference Include="..\..\src\Colony.Pathfinding\Colony.Pathfinding.csproj" />
    <ProjectReference Include="..\..\src\Colony.ProcGen\Colony.ProcGen.csproj" />
    <Compile Include="..\Colony.Core.Tests\Scenario\ColonistScenario.cs" Link="Scenarios\ColonistScenario.cs" />
    <Compile Include="..\Colony.Testing.Tests\Scenarios\ColonistHarnessScenario.cs" Link="Scenarios\ColonistHarnessScenario.cs" />
    <Compile Include="..\Colony.Testing.Tests\Scenarios\FieldScenario.cs" Link="Scenarios\FieldScenario.cs" />
    <Compile Include="..\Colony.Testing.Tests\Scenarios\InputScenario.cs" Link="Scenarios\InputScenario.cs" />
    <Compile Include="..\Colony.Testing.Tests\Scenarios\StreamingScenario.cs" Link="Scenarios\StreamingScenario.cs" />
    <!-- TASK-42 AC #3: the pathfinding, work index, generation and claims oracles. -->
    <Compile Include="..\Colony.Pathfinding.Tests\Scenarios\PrototypeTerrain.cs" Link="Scenarios\PrototypeTerrain.cs" />
    <Compile Include="..\Colony.Pathfinding.Tests\Scenarios\PathRequestScenario.cs" Link="Scenarios\PathRequestScenario.cs" />
    <Compile Include="..\Colony.Pathfinding.Tests\Scenarios\FlowFieldScenario.cs" Link="Scenarios\FlowFieldScenario.cs" />
    <Compile Include="..\Colony.Colony.Tests\Scenarios\ClaimScenario.cs" Link="Scenarios\ClaimScenario.cs" />
    <Compile Include="..\Colony.Colony.Tests\Scenarios\WorkIndexScenario.cs" Link="Scenarios\WorkIndexScenario.cs" />
    <Compile Include="..\Colony.ProcGen.Tests\Pipeline\TerrainPipeline.cs" Link="Scenarios\TerrainPipeline.cs" />
    <Compile Include="..\Colony.ProcGen.Tests\Pipeline\GenerationScenario.cs" Link="Scenarios\GenerationScenario.cs" />
  </ItemGroup>

</Project>

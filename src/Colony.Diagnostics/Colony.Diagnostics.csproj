<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Colony.Diagnostics: the host-side consumers of Core's diagnostics API (spec section 10.1): the logging
    drain that resolves structured entries to text, the hash-trail recorder and comparison, and (TASK-18) the
    EventSource/Meter bridge and Perfetto trace export. Core never references this package; it plugs into
    Core through IDiagnosticsListener and world.Diagnostics (enforced by tools/Colony.DependencyCheck).
    Depends on Colony.Core (and Colony.Fields / Colony.Persistence once they exist).
  -->

  <PropertyGroup>
    <Description>Colony Framework diagnostics: logging drain, hash trail comparison, profiling sinks and the inspection protocol.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Colony.Core\Colony.Core.csproj" />
    <!-- Spec section 3: Diagnostics reads Fields (Field cells, spatial queries) and Persistence (replay-based rewind, save diff). -->
    <ProjectReference Include="..\Colony.Fields\Colony.Fields.csproj" />
    <ProjectReference Include="..\Colony.Persistence\Colony.Persistence.csproj" />
  </ItemGroup>

  <!--
    COLONY_NO_INSPECT (spec section 10.2): building with -p:ColonyNoInspect=true (or COLONY_NO_INSPECT in
    DefineConstants) compiles the inspection server out of this assembly entirely; the protocol codec, client,
    colony-inspect commands that work offline, debug commands, hash-trail files and diffs stay.
  -->
  <ItemGroup Condition="'$(ColonyNoInspect)' == 'true'">
    <Compile Remove="Inspection\Server\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Colony.Diagnostics.Tests" />
  </ItemGroup>

</Project>

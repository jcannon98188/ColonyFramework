<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Colony.ProcGen: procedural generation (spec section 9.3). Fixed-point noise utilities (value, gradient,
    simplex, cellular, fBm, domain warping, region-keyed spot sampling) keyed by (seed, stage, coordinate, use index)
    so any chunk is a pure function of (seed, coordinate). Later tickets add the stage pipeline and ChunkProvider.
    Depends on Colony.Core (and Colony.Fields once it exists); enforced by tools/Colony.DependencyCheck.
  -->

  <PropertyGroup>
    <Description>Colony Framework procedural generation: deterministic fixed-point noise and generation pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Colony.Core\Colony.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Colony.ProcGen.Tests" />
  </ItemGroup>

</Project>

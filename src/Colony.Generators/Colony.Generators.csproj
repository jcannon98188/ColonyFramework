<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Colony.Generators: Roslyn incremental source generator and analyzers (spec section 3).
    Ships as an analyzer package; generated code lives in the user's assembly (spec section 11).
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Colony Framework source generator and analyzers.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <RootNamespace>Colony.Generators</RootNamespace>
    <!-- Roslyn components target netstandard2.0; the AOT/trim flags from src/Directory.Build.props do not apply. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn release tracking (RS2008): every diagnostic id is listed in these tables. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack as an analyzer, not as a lib. -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>

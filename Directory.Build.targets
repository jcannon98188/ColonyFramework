<Project>

  <!--
    Shared settings applied after each project file is read, so they can key off properties the
    project itself sets (IsTestProject). Test projects anywhere in the repo (tests/, tools/) run on
    Microsoft.Testing.Platform through xUnit v3; `dotnet test` uses the MTP runner via global.json.
  -->

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- CA1515 (make types internal) conflicts with xUnit's public test class convention;
         CA1707 (no underscores) conflicts with Sentence_case_test_names;
         CA1051/CA1815 (no public fields, struct equality) conflict with test Components, which are
         plain unmanaged data structs by design (spec section 2, principle 4). -->
    <NoWarn>$(NoWarn);CA1515;CA1707;CA1051;CA1815</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    COLONY_NO_INSPECT (spec section 10.2): -p:ColonyNoInspect=true defines the symbol in every project, so hosts
    can guard their inspection-server code; Colony.Diagnostics also drops its server sources (see its csproj).
    Passing COLONY_NO_INSPECT in DefineConstants directly sets ColonyNoInspect too.
  -->
  <PropertyGroup Condition="$(DefineConstants.Contains('COLONY_NO_INSPECT'))">
    <ColonyNoInspect>true</ColonyNoInspect>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ColonyNoInspect)' == 'true' and !$(DefineConstants.Contains('COLONY_NO_INSPECT'))">
    <DefineConstants>$(DefineConstants);COLONY_NO_INSPECT</DefineConstants>
  </PropertyGroup>

</Project>
